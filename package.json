{
  "name": "ald-workforce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @ald/web test:e2e",
    "db:generate": "pnpm --filter @ald/db db:generate",
    "db:migrate": "pnpm --filter @ald/db db:migrate",
    "db:deploy": "pnpm --filter @ald/db db:deploy",
    "db:seed": "pnpm --filter @ald/db db:seed",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "prettier": "3.6.2",
    "turbo": "2.10.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
