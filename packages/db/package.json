{
  "name": "@ald/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./generated/client": {
      "types": "./src/generated/prisma/client.ts",
      "import": "./dist/generated/prisma/client.js"
    }
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@better-auth/prisma-adapter": "1.6.24",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "better-auth": "1.6.24",
    "dotenv": "17.4.2",
    "prisma": "7.9.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
