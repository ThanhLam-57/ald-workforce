generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum EmploymentCategory {
  OFFICIAL
  PROBATION
  CONTRACTOR
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AssignmentType {
  MEMBER
  PRIMARY_MANAGER
  SECONDARY_MANAGER
}

enum AttendanceStatus {
  DRAFT
  PRESENT
  ABSENT
  LEAVE
}

enum RevenueUnit {
  VND
  THOUSAND_VND
}

enum RuleSetType {
  PENALTY
  DAILY_REWARD_TIERS
  MONTHLY_LEVEL_RULES
  SALARY_RULES
  KPI_TEMPLATE
}

enum RuleVersionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  RETIRED
}

enum ViolationStatus {
  ACTIVE
  CANCELLED
}

enum EvidenceStatus {
  PENDING_UPLOAD
  READY
  REJECTED
  CANCELLED
}

enum LevelProposalStatus {
  PENDING
  CONFIRMED
  OVERRIDDEN
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  REVIEWED
  LOCKED
  PUBLISHED
}

enum PayrollLineType {
  BASE_SALARY
  PRORATED_SALARY
  DAILY_REVENUE_BONUS
  MONTHLY_REVENUE_BONUS
  ATTENDANCE_BONUS
  ACHIEVEMENT_BONUS
  LEVEL_BONUS
  OVERTIME_PAY
  OTHER_BONUS
  PENALTY
  ADVANCE
  TOTAL_INCOME
}

enum PayrollAdjustmentType {
  OTHER_BONUS
  ADVANCE
  CORRECTION
}

enum PayrollExportKind {
  PAYSLIP_XLSX
  PAYSLIP_PDF
  BULK_ZIP
}

enum PayrollExportStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ManagerKpiEvaluationStatus {
  DRAFT
  PUBLISHED
}

enum ImportTemplate {
  BRANCHES
  STAFF
  ASSIGNMENTS
  LEVELS
  ATTENDANCE_LIVE
  REWARD_RULES
  PENALTY_RULES
  HISTORICAL_PAYROLL
}

enum ImportJobStatus {
  PENDING_UPLOAD
  UPLOADED
  VALIDATING
  VALIDATED
  COMMITTING
  SUCCEEDED
  FAILED
}

enum ImportErrorSeverity {
  WARNING
  ERROR
  CRITICAL
}

enum DataExportTemplate {
  EMPLOYEE_ERROR_REPORT
  BRANCH_MONTHLY
  PAYSLIP
  COMPANY_MONTHLY
  AUDIT
}

enum DataExportFormat {
  XLSX
  CSV
}

enum DataExportStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
}

model Company {
  id                           String                    @id @default(uuid()) @db.Uuid
  name                         String
  slug                         String                    @unique
  timezone                     String                    @default("Asia/Ho_Chi_Minh")
  revenueUnit                  RevenueUnit               @default(VND)
  revenueScale                 Int                       @default(1)
  selfServiceEnabled           Boolean                   @default(false)
  employeeRevenueVisible       Boolean                   @default(false)
  managerKpiSelfServiceEnabled Boolean                   @default(false)
  version                      Int                       @default(1)
  createdAt                    DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                  @updatedAt @db.Timestamptz(3)
  branches                     Branch[]
  staffMembers                 StaffMember[]
  users                        User[]
  branchAssignments            BranchAssignment[]
  attendanceDays               AttendanceDay[]
  liveDailyMetrics             LiveDailyMetric[]
  ruleSets                     RuleSet[]
  ruleVersions                 RuleVersion[]
  penaltyItems                 PenaltyItem[]
  violations                   Violation[]
  evidenceObjects              EvidenceObject[]
  performanceLevels            PerformanceLevel[]
  levelHistories               LevelHistory[]
  levelProposals               LevelProposal[]
  payrollPeriods               PayrollPeriod[]
  payrollEntries               PayrollEntry[]
  payrollLines                 PayrollLine[]
  payrollAdjustments           PayrollAdjustment[]
  calculationSnapshots         CalculationSnapshot[]
  payrollExportJobs            PayrollExportJob[]
  payrollDownloadLogs          PayrollDownloadLog[]
  staffEmploymentHistories     StaffEmploymentHistory[]
  managerKpiEvaluations        ManagerKpiEvaluation[]
  managerKpiLines              ManagerKpiCriterionLine[]
  importJobs                   ImportJob[]
  importErrors                 ImportError[]
  dataExportJobs               DataExportJob[]
  auditLogs                    AuditLog[]

  @@map("companies")
}

model Branch {
  id                    String                 @id @default(uuid()) @db.Uuid
  companyId             String                 @db.Uuid
  code                  String
  name                  String
  address               String?
  isActive              Boolean                @default(true)
  version               Int                    @default(1)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments           BranchAssignment[]
  attendanceDays        AttendanceDay[]
  liveDailyMetrics      LiveDailyMetric[]
  violations            Violation[]
  evidenceObjects       EvidenceObject[]
  payrollPeriods        PayrollPeriod[]
  payrollEntries        PayrollEntry[]
  payrollLines          PayrollLine[]
  payrollAdjustments    PayrollAdjustment[]
  calculationSnapshots  CalculationSnapshot[]
  payrollExportJobs     PayrollExportJob[]
  payrollDownloadLogs   PayrollDownloadLog[]
  managerKpiEvaluations ManagerKpiEvaluation[]
  importJobs            ImportJob[]
  dataExportJobs        DataExportJob[]
  auditLogs             AuditLog[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("branches")
}

model StaffMember {
  id                    String                   @id @default(uuid()) @db.Uuid
  companyId             String                   @db.Uuid
  staffCode             String
  fullName              String
  streamingAlias        String?
  email                 String?
  phone                 String?
  jobTitle              String
  employmentCategory    EmploymentCategory
  employmentStatus      EmploymentStatus         @default(ACTIVE)
  version               Int                      @default(1)
  archivedAt            DateTime?                @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  company               Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user                  User?
  assignments           BranchAssignment[]
  attendanceDays        AttendanceDay[]
  violations            Violation[]
  levelHistories        LevelHistory[]
  levelProposals        LevelProposal[]
  payrollEntries        PayrollEntry[]
  payrollAdjustments    PayrollAdjustment[]
  payrollExportJobs     PayrollExportJob[]
  payrollDownloadLogs   PayrollDownloadLog[]
  employmentHistories   StaffEmploymentHistory[]
  managerKpiEvaluations ManagerKpiEvaluation[]   @relation("ManagerKpiTarget")

  @@unique([companyId, staffCode])
  @@index([companyId, employmentStatus, archivedAt])
  @@index([companyId, employmentCategory, employmentStatus, archivedAt], map: "staff_members_company_category_status_archived_idx")
  @@map("staff_members")
}

model User {
  id                         String                   @id @default(uuid()) @db.Uuid
  companyId                  String                   @db.Uuid
  staffId                    String?                  @unique @db.Uuid
  name                       String
  email                      String                   @unique
  emailVerified              Boolean                  @default(false)
  image                      String?
  username                   String?                  @unique
  displayUsername            String?
  role                       String                   @default("LIVE_EMPLOYEE")
  active                     Boolean                  @default(true)
  banned                     Boolean                  @default(false)
  banReason                  String?
  banExpires                 DateTime?                @db.Timestamptz(3)
  mustChangePassword         Boolean                  @default(false)
  invitedAt                  DateTime?                @db.Timestamptz(3)
  passwordChangedAt          DateTime?                @db.Timestamptz(3)
  twoFactorEnabled           Boolean                  @default(false)
  version                    Int                      @default(1)
  createdAt                  DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                 @updatedAt @db.Timestamptz(3)
  company                    Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  staff                      StaffMember?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  sessions                   Session[]
  accounts                   Account[]
  twoFactor                  TwoFactor?
  auditLogs                  AuditLog[]               @relation("AuditActor")
  attendanceCreated          AttendanceDay[]          @relation("AttendanceCreatedBy")
  attendanceUpdated          AttendanceDay[]          @relation("AttendanceUpdatedBy")
  ruleSetsCreated            RuleSet[]                @relation("RuleSetCreatedBy")
  ruleVersionsCreated        RuleVersion[]            @relation("RuleVersionCreatedBy")
  ruleVersionsPublished      RuleVersion[]            @relation("RuleVersionPublishedBy")
  violationsCreated          Violation[]              @relation("ViolationCreatedBy")
  violationsCancelled        Violation[]              @relation("ViolationCancelledBy")
  evidenceCreated            EvidenceObject[]         @relation("EvidenceCreatedBy")
  levelHistoriesCreated      LevelHistory[]           @relation("LevelHistoryCreatedBy")
  levelProposalsDecided      LevelProposal[]          @relation("LevelProposalDecidedBy")
  payrollPeriodsCreated      PayrollPeriod[]          @relation("PayrollPeriodCreatedBy")
  payrollPeriodsReviewed     PayrollPeriod[]          @relation("PayrollPeriodReviewedBy")
  payrollPeriodsLocked       PayrollPeriod[]          @relation("PayrollPeriodLockedBy")
  payrollPeriodsPublished    PayrollPeriod[]          @relation("PayrollPeriodPublishedBy")
  payrollAdjustmentsCreated  PayrollAdjustment[]      @relation("PayrollAdjustmentCreatedBy")
  payrollAdjustmentsApproved PayrollAdjustment[]      @relation("PayrollAdjustmentApprovedBy")
  payrollSnapshotsCalculated CalculationSnapshot[]    @relation("PayrollSnapshotCalculatedBy")
  payrollExportsRequested    PayrollExportJob[]       @relation("PayrollExportRequestedBy")
  payrollDownloads           PayrollDownloadLog[]     @relation("PayrollDownloadUser")
  employmentHistoriesCreated StaffEmploymentHistory[] @relation("EmploymentHistoryCreatedBy")
  managerKpiCreated          ManagerKpiEvaluation[]   @relation("ManagerKpiCreatedBy")
  managerKpiPublished        ManagerKpiEvaluation[]   @relation("ManagerKpiPublishedBy")
  importJobsRequested        ImportJob[]              @relation("ImportRequestedBy")
  dataExportsRequested       DataExportJob[]          @relation("DataExportRequestedBy")

  @@index([companyId, role, active])
  @@map("users")
}

model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)
  userId                  String    @unique @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("two_factors")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@index([lastRequest])
  @@map("rate_limits")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?  @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model BranchAssignment {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  branchId       String         @db.Uuid
  staffId        String         @db.Uuid
  assignmentType AssignmentType @default(MEMBER)
  effectiveFrom  DateTime       @db.Date
  effectiveTo    DateTime?      @db.Date
  version        Int            @default(1)
  archivedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff          StaffMember    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([companyId, branchId, effectiveFrom, effectiveTo])
  @@index([companyId, staffId, effectiveFrom, effectiveTo])
  @@map("branch_assignments")
}

model PerformanceLevel {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @db.Uuid
  code               String
  name               String
  displayOrder       Int             @default(0)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  histories          LevelHistory[]
  suggestedProposals LevelProposal[] @relation("SuggestedPerformanceLevel")
  confirmedProposals LevelProposal[] @relation("ConfirmedPerformanceLevel")

  @@unique([companyId, code], map: "performance_levels_company_code_key")
  @@index([companyId, isActive, displayOrder], map: "performance_levels_company_active_order_idx")
  @@map("performance_levels")
}

model LevelHistory {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @db.Uuid
  staffId            String           @db.Uuid
  performanceLevelId String           @db.Uuid
  effectiveFrom      DateTime         @db.Date
  effectiveTo        DateTime?        @db.Date
  version            Int              @default(1)
  createdByUserId    String           @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  staff              StaffMember      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  performanceLevel   PerformanceLevel @relation(fields: [performanceLevelId], references: [id], onDelete: Restrict)
  createdBy          User             @relation("LevelHistoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, staffId, effectiveFrom, effectiveTo], map: "level_history_company_staff_interval_idx")
  @@index([companyId, performanceLevelId, effectiveFrom, effectiveTo], map: "level_history_company_level_interval_idx")
  @@map("level_history")
}

model LevelProposal {
  id                          String              @id @default(uuid()) @db.Uuid
  companyId                   String              @db.Uuid
  staffId                     String              @db.Uuid
  sourceMonth                 DateTime            @db.Date
  effectiveFrom               DateTime            @db.Date
  ruleVersionId               String              @db.Uuid
  suggestedPerformanceLevelId String              @db.Uuid
  confirmedPerformanceLevelId String?             @db.Uuid
  monthlyRevenue              BigInt
  status                      LevelProposalStatus @default(PENDING)
  version                     Int                 @default(1)
  decisionReason              String?
  decidedByUserId             String?             @db.Uuid
  decidedAt                   DateTime?           @db.Timestamptz(3)
  createdAt                   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime            @updatedAt @db.Timestamptz(3)
  company                     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  staff                       StaffMember         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  ruleVersion                 RuleVersion         @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  suggestedPerformanceLevel   PerformanceLevel    @relation("SuggestedPerformanceLevel", fields: [suggestedPerformanceLevelId], references: [id], onDelete: Restrict)
  confirmedPerformanceLevel   PerformanceLevel?   @relation("ConfirmedPerformanceLevel", fields: [confirmedPerformanceLevelId], references: [id], onDelete: Restrict)
  decidedBy                   User?               @relation("LevelProposalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@unique([companyId, staffId, sourceMonth], map: "level_proposals_company_staff_month_key")
  @@index([companyId, sourceMonth, status], map: "level_proposals_company_month_status_idx")
  @@index([companyId, effectiveFrom, status], map: "level_proposals_company_effective_status_idx")
  @@map("level_proposals")
}

model AttendanceDay {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  branchId        String           @db.Uuid
  staffId         String           @db.Uuid
  businessDate    DateTime         @db.Date
  checkInAt       DateTime?        @db.Timestamptz(3)
  checkOutAt      DateTime?        @db.Timestamptz(3)
  spansNextDay    Boolean          @default(false)
  workUnits       Decimal          @default(0) @db.Decimal(6, 2)
  overtimeMinutes Int              @default(0)
  note            String?
  status          AttendanceStatus @default(DRAFT)
  version         Int              @default(1)
  archivedAt      DateTime?        @db.Timestamptz(3)
  createdByUserId String           @db.Uuid
  updatedByUserId String           @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff           StaffMember      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("AttendanceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User             @relation("AttendanceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  liveMetric      LiveDailyMetric?
  violations      Violation[]

  @@unique([companyId, staffId, businessDate], map: "attendance_days_company_staff_date_key")
  @@index([companyId, branchId, businessDate], map: "attendance_days_company_branch_date_idx")
  @@index([companyId, branchId, businessDate, staffId], map: "attendance_days_company_branch_date_staff_idx")
  @@index([companyId, staffId, businessDate], map: "attendance_days_company_staff_date_idx")
  @@map("attendance_days")
}

model LiveDailyMetric {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @db.Uuid
  branchId          String        @db.Uuid
  attendanceId      String        @unique @db.Uuid
  actualLiveMinutes Int           @default(0)
  revenueAmount     BigInt        @default(0)
  revenueUnit       RevenueUnit
  revenueScale      Int
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  attendance        AttendanceDay @relation(fields: [attendanceId], references: [id], onDelete: Restrict)

  @@index([companyId, branchId, attendanceId], map: "live_daily_metrics_company_branch_attendance_idx")
  @@map("live_daily_metrics")
}

model RuleSet {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  type            RuleSetType   @default(PENALTY)
  name            String
  version         Int           @default(1)
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy       User          @relation("RuleSetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions        RuleVersion[]

  @@unique([companyId, type, name], map: "rule_sets_company_type_name_key")
  @@index([companyId, type], map: "rule_sets_company_type_idx")
  @@map("rule_sets")
}

model RuleVersion {
  id                    String                 @id @default(uuid()) @db.Uuid
  companyId             String                 @db.Uuid
  ruleSetId             String                 @db.Uuid
  versionNo             Int
  status                RuleVersionStatus      @default(DRAFT)
  effectiveFrom         DateTime?              @db.Date
  effectiveTo           DateTime?              @db.Date
  notes                 String?
  configuration         Json?
  rowVersion            Int                    @default(1)
  clonedFromVersionId   String?                @db.Uuid
  createdByUserId       String                 @db.Uuid
  publishedByUserId     String?                @db.Uuid
  publishedAt           DateTime?              @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ruleSet               RuleSet                @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  clonedFrom            RuleVersion?           @relation("RuleVersionClone", fields: [clonedFromVersionId], references: [id], onDelete: Restrict)
  clones                RuleVersion[]          @relation("RuleVersionClone")
  createdBy             User                   @relation("RuleVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy           User?                  @relation("RuleVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  items                 PenaltyItem[]
  violations            Violation[]
  levelProposals        LevelProposal[]
  payrollLines          PayrollLine[]
  managerKpiEvaluations ManagerKpiEvaluation[]

  @@unique([ruleSetId, versionNo], map: "rule_versions_set_version_key")
  @@index([companyId, status, effectiveFrom, effectiveTo], map: "rule_versions_company_status_interval_idx")
  @@map("rule_versions")
}

model PenaltyItem {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @db.Uuid
  ruleVersionId  String      @db.Uuid
  code           String
  name           String
  description    String
  defaultAmount  BigInt
  reminderPolicy Json?
  metadata       Json?
  isActive       Boolean     @default(true)
  displayColor   String      @default("#64748B")
  displayOrder   Int         @default(0)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ruleVersion    RuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  violations     Violation[]

  @@unique([ruleVersionId, code], map: "penalty_items_version_code_key")
  @@index([companyId, ruleVersionId, isActive, displayOrder], map: "penalty_items_company_version_active_order_idx")
  @@map("penalty_items")
}

model Violation {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @db.Uuid
  branchId           String           @db.Uuid
  attendanceId       String           @db.Uuid
  staffId            String           @db.Uuid
  businessDate       DateTime         @db.Date
  penaltyItemId      String           @db.Uuid
  ruleVersionId      String           @db.Uuid
  itemName           String
  amount             BigInt
  detail             String
  note               String?
  overrideReason     String?
  status             ViolationStatus  @default(ACTIVE)
  version            Int              @default(1)
  createdByUserId    String           @db.Uuid
  cancelledByUserId  String?          @db.Uuid
  cancelledAt        DateTime?        @db.Timestamptz(3)
  cancellationReason String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  attendance         AttendanceDay    @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  staff              StaffMember      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  penaltyItem        PenaltyItem      @relation(fields: [penaltyItemId], references: [id], onDelete: Restrict)
  ruleVersion        RuleVersion      @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  createdBy          User             @relation("ViolationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy        User?            @relation("ViolationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  evidenceObjects    EvidenceObject[]

