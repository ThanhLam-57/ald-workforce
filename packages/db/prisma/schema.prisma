generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum EmploymentCategory {
  OFFICIAL
  PROBATION
  CONTRACTOR
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AssignmentType {
  MEMBER
  PRIMARY_MANAGER
  SECONDARY_MANAGER
}

enum AttendanceStatus {
  DRAFT
  PRESENT
  ABSENT
  LEAVE
}

enum RevenueUnit {
  VND
  THOUSAND_VND
}

enum RuleSetType {
  PENALTY
  DAILY_REWARD_TIERS
  MONTHLY_LEVEL_RULES
  SALARY_RULES
  KPI_TEMPLATE
}

enum RuleVersionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  RETIRED
}

enum ViolationStatus {
  ACTIVE
  CANCELLED
}

enum EvidenceStatus {
  PENDING_UPLOAD
  READY
  REJECTED
  CANCELLED
}

enum LevelProposalStatus {
  PENDING
  CONFIRMED
  OVERRIDDEN
}

model Company {
  id                     String             @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String             @unique
  timezone               String             @default("Asia/Ho_Chi_Minh")
  revenueUnit            RevenueUnit        @default(VND)
  revenueScale           Int                @default(1)
  selfServiceEnabled     Boolean            @default(false)
  employeeRevenueVisible Boolean            @default(false)
  version                Int                @default(1)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)
  branches               Branch[]
  staffMembers           StaffMember[]
  users                  User[]
  branchAssignments      BranchAssignment[]
  attendanceDays         AttendanceDay[]
  liveDailyMetrics       LiveDailyMetric[]
  ruleSets               RuleSet[]
  ruleVersions           RuleVersion[]
  penaltyItems           PenaltyItem[]
  violations             Violation[]
  evidenceObjects        EvidenceObject[]
  performanceLevels      PerformanceLevel[]
  levelHistories         LevelHistory[]
  levelProposals         LevelProposal[]
  auditLogs              AuditLog[]

  @@map("companies")
}

model Branch {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @db.Uuid
  code             String
  name             String
  address          String?
  isActive         Boolean            @default(true)
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments      BranchAssignment[]
  attendanceDays   AttendanceDay[]
  liveDailyMetrics LiveDailyMetric[]
  violations       Violation[]
  evidenceObjects  EvidenceObject[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("branches")
}

model StaffMember {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  staffCode          String
  fullName           String
  streamingAlias     String?
  email              String?
  phone              String?
  jobTitle           String
  employmentCategory EmploymentCategory
  employmentStatus   EmploymentStatus   @default(ACTIVE)
  version            Int                @default(1)
  archivedAt         DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user               User?
  assignments        BranchAssignment[]
  attendanceDays     AttendanceDay[]
  violations         Violation[]
  levelHistories     LevelHistory[]
  levelProposals     LevelProposal[]

  @@unique([companyId, staffCode])
  @@index([companyId, employmentStatus, archivedAt])
  @@index([companyId, employmentCategory, employmentStatus, archivedAt])
  @@map("staff_members")
}

model User {
  id                    String           @id @default(uuid()) @db.Uuid
  companyId             String           @db.Uuid
  staffId               String?          @unique @db.Uuid
  name                  String
  email                 String           @unique
  emailVerified         Boolean          @default(false)
  image                 String?
  username              String?          @unique
  displayUsername       String?
  role                  String           @default("LIVE_EMPLOYEE")
  active                Boolean          @default(true)
  banned                Boolean          @default(false)
  banReason             String?
  banExpires            DateTime?        @db.Timestamptz(3)
  version               Int              @default(1)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)
  company               Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  staff                 StaffMember?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  sessions              Session[]
  accounts              Account[]
  auditLogs             AuditLog[]       @relation("AuditActor")
  attendanceCreated     AttendanceDay[]  @relation("AttendanceCreatedBy")
  attendanceUpdated     AttendanceDay[]  @relation("AttendanceUpdatedBy")
  ruleSetsCreated       RuleSet[]        @relation("RuleSetCreatedBy")
  ruleVersionsCreated   RuleVersion[]    @relation("RuleVersionCreatedBy")
  ruleVersionsPublished RuleVersion[]    @relation("RuleVersionPublishedBy")
  violationsCreated     Violation[]      @relation("ViolationCreatedBy")
  violationsCancelled   Violation[]      @relation("ViolationCancelledBy")
  evidenceCreated       EvidenceObject[] @relation("EvidenceCreatedBy")
  levelHistoriesCreated LevelHistory[]   @relation("LevelHistoryCreatedBy")
  levelProposalsDecided LevelProposal[]  @relation("LevelProposalDecidedBy")

  @@index([companyId, role, active])
  @@map("users")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  expiresAt      DateTime @db.Timestamptz(3)
  token          String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?  @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model BranchAssignment {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @db.Uuid
  branchId       String         @db.Uuid
  staffId        String         @db.Uuid
  assignmentType AssignmentType @default(MEMBER)
  effectiveFrom  DateTime       @db.Date
  effectiveTo    DateTime?      @db.Date
  version        Int            @default(1)
  archivedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff          StaffMember    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([companyId, branchId, effectiveFrom, effectiveTo])
  @@index([companyId, staffId, effectiveFrom, effectiveTo])
  @@map("branch_assignments")
}

model PerformanceLevel {
  id                 String          @id @default(uuid()) @db.Uuid
  companyId          String          @db.Uuid
  code               String
  name               String
  displayOrder       Int             @default(0)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  histories          LevelHistory[]
  suggestedProposals LevelProposal[] @relation("SuggestedPerformanceLevel")
  confirmedProposals LevelProposal[] @relation("ConfirmedPerformanceLevel")

  @@unique([companyId, code])
  @@index([companyId, isActive, displayOrder])
  @@map("performance_levels")
}

model LevelHistory {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @db.Uuid
  staffId            String           @db.Uuid
  performanceLevelId String           @db.Uuid
  effectiveFrom      DateTime         @db.Date
  effectiveTo        DateTime?        @db.Date
  version            Int              @default(1)
  createdByUserId    String           @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  staff              StaffMember      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  performanceLevel   PerformanceLevel @relation(fields: [performanceLevelId], references: [id], onDelete: Restrict)
  createdBy          User             @relation("LevelHistoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, staffId, effectiveFrom, effectiveTo])
  @@index([companyId, performanceLevelId, effectiveFrom, effectiveTo])
  @@map("level_history")
}

model LevelProposal {
  id                          String              @id @default(uuid()) @db.Uuid
  companyId                   String              @db.Uuid
  staffId                     String              @db.Uuid
  sourceMonth                 DateTime            @db.Date
  effectiveFrom               DateTime            @db.Date
  ruleVersionId               String              @db.Uuid
  suggestedPerformanceLevelId String              @db.Uuid
  confirmedPerformanceLevelId String?             @db.Uuid
  monthlyRevenue              BigInt
  status                      LevelProposalStatus @default(PENDING)
  version                     Int                 @default(1)
  decisionReason              String?
  decidedByUserId             String?             @db.Uuid
  decidedAt                   DateTime?           @db.Timestamptz(3)
  createdAt                   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime            @updatedAt @db.Timestamptz(3)
  company                     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  staff                       StaffMember         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  ruleVersion                 RuleVersion         @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  suggestedPerformanceLevel   PerformanceLevel    @relation("SuggestedPerformanceLevel", fields: [suggestedPerformanceLevelId], references: [id], onDelete: Restrict)
  confirmedPerformanceLevel   PerformanceLevel?   @relation("ConfirmedPerformanceLevel", fields: [confirmedPerformanceLevelId], references: [id], onDelete: Restrict)
  decidedBy                   User?               @relation("LevelProposalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@unique([companyId, staffId, sourceMonth])
  @@index([companyId, sourceMonth, status])
  @@index([companyId, effectiveFrom, status])
  @@map("level_proposals")
}

model AttendanceDay {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  branchId        String           @db.Uuid
  staffId         String           @db.Uuid
  businessDate    DateTime         @db.Date
  checkInAt       DateTime?        @db.Timestamptz(3)
  checkOutAt      DateTime?        @db.Timestamptz(3)
  spansNextDay    Boolean          @default(false)
  workUnits       Decimal          @default(0) @db.Decimal(6, 2)
  overtimeMinutes Int              @default(0)
  note            String?
  status          AttendanceStatus @default(DRAFT)
  version         Int              @default(1)
  archivedAt      DateTime?        @db.Timestamptz(3)
  createdByUserId String           @db.Uuid
  updatedByUserId String           @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff           StaffMember      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("AttendanceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy       User             @relation("AttendanceUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  liveMetric      LiveDailyMetric?
  violations      Violation[]

  @@unique([companyId, staffId, businessDate])
  @@index([companyId, branchId, businessDate])
  @@index([companyId, branchId, businessDate, staffId])
  @@index([companyId, staffId, businessDate])
  @@map("attendance_days")
}

model LiveDailyMetric {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @db.Uuid
  branchId          String        @db.Uuid
  attendanceId      String        @unique @db.Uuid
  actualLiveMinutes Int           @default(0)
  revenueAmount     BigInt        @default(0)
  revenueUnit       RevenueUnit
  revenueScale      Int
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  attendance        AttendanceDay @relation(fields: [attendanceId], references: [id], onDelete: Restrict)

  @@index([companyId, branchId, attendanceId])
  @@map("live_daily_metrics")
}

model RuleSet {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  type            RuleSetType   @default(PENALTY)
  name            String
  version         Int           @default(1)
  createdByUserId String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy       User          @relation("RuleSetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions        RuleVersion[]

  @@unique([companyId, type, name])
  @@index([companyId, type])
  @@map("rule_sets")
}

model RuleVersion {
  id                  String            @id @default(uuid()) @db.Uuid
  companyId           String            @db.Uuid
  ruleSetId           String            @db.Uuid
  versionNo           Int
  status              RuleVersionStatus @default(DRAFT)
  effectiveFrom       DateTime?         @db.Date
  effectiveTo         DateTime?         @db.Date
  notes               String?
  configuration       Json?
  rowVersion          Int               @default(1)
  clonedFromVersionId String?           @db.Uuid
  createdByUserId     String            @db.Uuid
  publishedByUserId   String?           @db.Uuid
  publishedAt         DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ruleSet             RuleSet           @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  clonedFrom          RuleVersion?      @relation("RuleVersionClone", fields: [clonedFromVersionId], references: [id], onDelete: Restrict)
  clones              RuleVersion[]     @relation("RuleVersionClone")
  createdBy           User              @relation("RuleVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy         User?             @relation("RuleVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  items               PenaltyItem[]
  violations          Violation[]
  levelProposals      LevelProposal[]

  @@unique([ruleSetId, versionNo])
  @@index([companyId, status, effectiveFrom, effectiveTo])
  @@map("rule_versions")
}

model PenaltyItem {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @db.Uuid
  ruleVersionId  String      @db.Uuid
  code           String
  name           String
  description    String
  defaultAmount  BigInt
  reminderPolicy Json?
  metadata       Json?
  isActive       Boolean     @default(true)
  displayColor   String      @default("#64748B")
  displayOrder   Int         @default(0)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ruleVersion    RuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  violations     Violation[]

  @@unique([ruleVersionId, code])
  @@index([companyId, ruleVersionId, isActive, displayOrder])
  @@map("penalty_items")
}

model Violation {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @db.Uuid
  branchId           String           @db.Uuid
  attendanceId       String           @db.Uuid
  staffId            String           @db.Uuid
  businessDate       DateTime         @db.Date
  penaltyItemId      String           @db.Uuid
  ruleVersionId      String           @db.Uuid
  itemName           String
  amount             BigInt
  detail             String
  note               String?
  overrideReason     String?
  status             ViolationStatus  @default(ACTIVE)
  version            Int              @default(1)
  createdByUserId    String           @db.Uuid
  cancelledByUserId  String?          @db.Uuid
  cancelledAt        DateTime?        @db.Timestamptz(3)
  cancellationReason String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch             Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  attendance         AttendanceDay    @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  staff              StaffMember      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  penaltyItem        PenaltyItem      @relation(fields: [penaltyItemId], references: [id], onDelete: Restrict)
  ruleVersion        RuleVersion      @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  createdBy          User             @relation("ViolationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy        User?            @relation("ViolationCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  evidenceObjects    EvidenceObject[]

  @@index([companyId, branchId, businessDate, status])
  @@index([companyId, staffId, businessDate, status])
  @@index([attendanceId, status])
  @@map("violations")
}

model EvidenceObject {
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @db.Uuid
  branchId         String         @db.Uuid
  violationId      String         @db.Uuid
  objectKey        String         @unique
  originalFileName String
  mimeType         String
  sizeBytes        BigInt
  checksumSha256   String
  status           EvidenceStatus @default(PENDING_UPLOAD)
  version          Int            @default(1)
  createdByUserId  String         @db.Uuid
  uploadedAt       DateTime?      @db.Timestamptz(3)
  verifiedAt       DateTime?      @db.Timestamptz(3)
  rejectionReason  String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  violation        Violation      @relation(fields: [violationId], references: [id], onDelete: Restrict)
  createdBy        User           @relation("EvidenceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, branchId, violationId, status])
  @@map("evidence_objects")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  reason      String
  before      Json?
  after       Json?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  occurredAt  DateTime @default(now()) @db.Timestamptz(3)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, occurredAt(sort: Desc)])
  @@index([companyId, entityType, entityId])
  @@map("audit_logs")
}
