# Local PostgreSQL
DATABASE_URL=postgresql://ald:ald_local_password@127.0.0.1:55432/ald_workforce
DATABASE_POOL_MAX=10

# Better Auth - generate a unique secret for every non-local environment
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed (local only)
SEED_COMPANY_NAME=ALD
SEED_COMPANY_SLUG=ald
SEED_GM_NAME=Tổng quản lý
SEED_GM_EMAIL=admin@ald.local
SEED_GM_USERNAME=admin
SEED_GM_PASSWORD=ChangeMe-12345!

# S3-compatible private storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ald-private
S3_ACCESS_KEY=ald_minio
S3_SECRET_KEY=ald_minio_local_password
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
