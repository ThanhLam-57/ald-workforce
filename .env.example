# Copy to .env and replace every <placeholder>. Never commit the populated file.
DATABASE_URL=postgresql://<db-user>:<db-password>@127.0.0.1:55432/<db-name>
DATABASE_POOL_MAX=10

# Generate independent random values for every environment.
BETTER_AUTH_SECRET=<at-least-32-random-characters>
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
METRICS_TOKEN=<random-observability-token>

# Demo seed. Do not run against production; passwords are injected, never printed.
ALLOW_DEMO_SEED=false
SEED_COMPANY_NAME=ALD
SEED_COMPANY_SLUG=ald
SEED_GM_NAME=Tổng quản lý
SEED_GM_EMAIL=admin@ald.local
SEED_GM_USERNAME=admin
SEED_GM_PASSWORD=<strong-temporary-password>
SEED_MANAGER_PASSWORD=<different-strong-temporary-password>
SEED_EMPLOYEE_PASSWORD=<different-strong-temporary-password>
SEED_PAYROLL_MONTH=2026-07

# One-time production admin bootstrap. Keep disabled after the first successful deploy.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_COMPANY_NAME=ALD
BOOTSTRAP_COMPANY_SLUG=ald
BOOTSTRAP_REVENUE_UNIT=COIN
BOOTSTRAP_ADMIN_STAFF_CODE=GM001
BOOTSTRAP_ADMIN_NAME=Tổng quản lý
BOOTSTRAP_ADMIN_EMAIL=admin@ald.local
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=<strong-temporary-password>

# S3-compatible private storage.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=<private-bucket-name>
S3_ACCESS_KEY=<storage-access-key>
S3_SECRET_KEY=<storage-secret-key>
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false
EXPORT_RETENTION_DAYS=30

# Optional provider integration.
ERROR_TRACKING_DSN=
